# Production environment for the API (Cloud Run revision env vars or a VM env file).
# Development defaults exist for everything except the two secrets below.

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# REQUIRED in production (min 32 chars each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# SQLite file. In Docker/Cloud Run this must be a persistent volume (/data).
DATABASE_FILE=/data/mediflow.db

# Online backups (`npm run db:backup`). Cron/systemd-timer friendly; keeps N days.
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=7

# The Firebase Hosting URL of the web app, so the browser is allowed to call in.
# Example: CORS_ORIGINS=https://mediflow-prod.web.app
CORS_ORIGINS=

# Production refuses WHATSAPP_PROVIDER=simulator. Send from the API with the
# Cloud API (Meta) below.
#
# There is no baileys option here on purpose. The consumer-protocol session and
# its QR pairing belong to the separate gateway service, which drains the
# Firestore outbox. Point the two device-linking routes at it with the values
# below; the token is read here and never sent to the browser.
WHATSAPP_PROVIDER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Gateway base URL, e.g. https://mediflow-gateway.onrender.com (no trailing /)
GATEWAY_URL=
# Must match the gateway's own GATEWAY_ADMIN_TOKEN.
GATEWAY_ADMIN_TOKEN=

# Staff password reset by email. With SMTP_HOST unset the feature is off and
# /auth/password/forgot answers 503, so a user is never told to check an inbox
# that will stay empty.
#
# SMTP_PORT 465 is implicit TLS; 587 (the default) uses STARTTLS. Credentials are
# only ever sent after the connection is encrypted.
# MAIL_FROM is the envelope sender; if blank, SMTP_USER is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public origin of the web app, used to build the link in the reset email,
# e.g. https://your-clinic.web.app  (no trailing slash)
PUBLIC_WEB_URL=

# First owner on a fresh database: run
#   node apps/api/scripts/create-owner.mjs <email> <password> [clinic-name]
# from a shell on the server. There is deliberately no HTTP endpoint for this.


# Patient files (photos, documents) live here. On Render this must be on the
# persistent disk (/data), or uploads vanish on every redeploy.
UPLOADS_DIR=

# Run the reminder worker inside the API process (single-container deploys).
# Larger deploys set REMINDER_WORKER_ENABLED=false and run `npm run worker:start`
# as a second Cloud Run service against the same database.
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_MS=30000

# Error tracking (P1 observability): optional webhook receiving JSON error
# reports from the API and (via /system/client-events) from browsers.
ERROR_WEBHOOK_URL=
