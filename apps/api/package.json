{
  "name": "@mediflow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build --workspace @mediflow/shared && tsx watch src/index.ts",
    "build": "npm run build --workspace @mediflow/shared && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "tsx src/db/reset-cli.ts",
    "db:backup": "tsx src/db/backup-cli.ts",
    "db:backup:firestore": "bash ../../tools/firestore-backup.sh",
    "admin:pending": "tsx src/admin-cli.ts pending",
    "admin:approve": "tsx src/admin-cli.ts approve",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@mediflow/shared": "*",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.9.0",
    "fastify": "^5.2.0",
    "firebase-admin": "^14.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
