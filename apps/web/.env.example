# Copy to `.env` and adjust. The API must allow this origin via CORS:
# CORS_ORIGINS=http://localhost:5171 npm run dev:api
VITE_API_URL=http://localhost:4000

# Firebase identity plane (one project per clinic). The reseller dashboard
# writes these per customer as `.env.<nick>` — same pattern as the POS fleet.
# When all four are present the app signs doctors in with Firebase Auth and
# checks the config/appStatus licence doc; otherwise it uses the API login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
